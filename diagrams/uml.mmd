classDiagram
    class Task {
        +String description
        +int duration_minutes
        +String frequency
        +bool completed
        +String time
        +date due_date
        +validate() bool
        +mark_complete()
        +next_occurrence() Task
    }

    class Pet {
        +String name
        +String species
        +List~Task~ tasks
        +add_task(task)
    }

    class Owner {
        +String name
        +int available_minutes
        +List~Pet~ pets
        +set_availability(minutes)
        +add_pet(pet)
        +get_all_tasks(completed, pet_name) List~Task~
    }

    class Scheduler {
        +complete_task(pet, task) Task
        +sort_by_time(tasks) List~Task~
        +detect_conflicts(owner) List~String~
        +generate_plan(owner) List~Task~
    }

    Owner "1" --> "0..*" Pet : has
    Pet "1" --> "0..*" Task : has
    Task ..> Task : next_occurrence() creates copy
    Scheduler ..> Owner : reads pets, tasks and available time
    Scheduler ..> Pet : complete_task() adds recurring task to
    Scheduler ..> Task : sorts, plans and completes
